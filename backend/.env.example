# Database
DB_URL=jdbc:mysql://localhost:3306/electrohub?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=electrohub
DB_PASSWORD=replace_with_your_mysql_password

# Single owner/admin account
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_unique_long_password

# Razorpay - leave blank until you create live/test credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email - Amazon SES SMTP recommended for production
MAIL_ENABLED=false
MAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# OTP security. Generate a long random value, e.g. openssl rand -hex 32
OTP_PEPPER=
OTP_TTL_MINUTES=5

# MSG91 mobile OTP - enabling this can create billable SMS usage
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Image storage. Keep local while developing. Set to r2 only after R2 is configured.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

COOKIE_SECURE=false
SEED_CATALOG=true
PORT=8080
